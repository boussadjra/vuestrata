{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(vp check)",
      "Bash(vpr lint)",
      "Bash(vpr fmt --check)",
      "Bash(vpr test --run)",
      "Bash(vpr test:unit)",
      "Bash(vpr test:component)",
      "Bash(vpr test:integration)",
      "Bash(vpr typecheck)",
      "Bash(vpr typecheck:e2e)",
      "Bash(vp exec vue-tsc --noEmit)",
      "Bash(vpr gen --help)",
      "Bash(vp toolchain)",
      "Bash(node scripts/lint/run-custom-rules.mjs)",
      "Bash(node scripts/docs/check-links.mjs)",
      "Bash(node scripts/docs/check-links.mjs --quiet)",
      "Bash(node scripts/msw/check-worker-version.mjs)",
      "Bash(node scripts/build/verify-bundle.mjs *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git show *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "vp check",
            "timeout": 180,
            "statusMessage": "Running vp check"
          }
        ]
      }
    ]
  }
}
