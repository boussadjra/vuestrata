# Vuestrata Environment Variables
# Copy this file to .env.local and fill in the values.
# All keys must be prefixed with VUESTRATA_ (see envPrefix in vite.config.ts)
# to be exposed to client code via import.meta.env.

# ── Application ────────────────────────────────────────────
VUESTRATA_APP_TITLE=Vuestrata

# ── HTTP / API ─────────────────────────────────────────────
# Base URL for the backend API. Use /api for same-origin behind a proxy.
VUESTRATA_API_URL=http://localhost:3000/api

# When true, MSW mock handlers intercept every fetch in the browser.
# When false, requests hit VUESTRATA_API_URL directly.
VUESTRATA_USE_MOCKS=true

# ── Auth ───────────────────────────────────────────────────
# mock  — in-memory mock adapter (no persistence on refresh)
# jwt   — credentials + JWT bearer (refresh via /auth/refresh)
# oauth — OAuth/PKCE flow against the providers in src/modules/auth
VUESTRATA_AUTH_ADAPTER=mock

# ── UI / theming ───────────────────────────────────────────
# reka (Reka UI / shadcn-style) or vuetify0 (Vuetify 0)
VUESTRATA_UI_PROVIDER=reka

# solar | lucide | phosphor
VUESTRATA_ICON_PROVIDER=solar

# Default theme name for fresh sessions. Persisted `vuestrata-theme`
# localStorage values override this after the first visit.
# default | blueprint | brutalist | febin | forest | ghibli | ocean | rose | sunset | terminal
VUESTRATA_THEME=default

# Validator backing the form layer.
# zod | valibot | yup | arktype
VUESTRATA_VALIDATION_ADAPTER=zod

# Demo auth retention: how long (hours, min 1) demo sessions remain in IndexedDB
# Exposed to the client as `import.meta.env.VITE_VUESTRATA_DEMO_AUTH_RETENTION_HOURS`
VITE_VUESTRATA_DEMO_AUTH_RETENTION_HOURS=24
