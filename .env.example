# Vuestrata Environment Variables
# Copy this file to .env.local and fill in the values.
#
# All keys must be prefixed with VUESTRATA_ (see envPrefix in vite.config.ts)
# to be exposed to client code via import.meta.env. That prefix REPLACES Vite's
# default VITE_ prefix — a VITE_* variable is never exposed here.
#
# Everything in this file is inlined into the client bundle at build time and is
# therefore PUBLIC. Never put a secret, API key, or client secret in it.
#
# Validation lives in src/modules/core/lib/config/env.schema.ts and runs twice:
# strictly at build time (an invalid combination fails `vp build`) and leniently
# in the browser (falls back with a warning rather than white-screening).

# ── Runtime mode ───────────────────────────────────────────
# The single switch that decides which artifact is produced.
#
#   demo       — public showcase. MSW intercepts every request; mock auth only.
#                No backend required.
#   production — real deployment. MSW is not bundled, demo state is compiled
#                out, and a real auth adapter is required.
#
# Defaults to `demo` in development and `production` in a build.
VUESTRATA_RUNTIME_MODE=demo

# ── Application ────────────────────────────────────────────
VUESTRATA_APP_TITLE=Vuestrata

# ── HTTP / API ─────────────────────────────────────────────
# Base URL for the backend API. Use /api for same-origin behind a proxy.
# In production mode this may not point at a placeholder host such as
# localhost or api.example.com — the build rejects it.
VUESTRATA_API_URL=/api

# When true, MSW mock handlers intercept every fetch in the browser.
# When false, requests hit VUESTRATA_API_URL directly.
# Defaults to true in demo mode and false in production mode; it must agree
# with VUESTRATA_RUNTIME_MODE.
VUESTRATA_USE_MOCKS=true

# ── Auth ───────────────────────────────────────────────────
# mock  — demo adapter backed by IndexedDB. Requires demo mode: its endpoints
#         only exist inside MSW.
# jwt   — credentials + JWT bearer (refresh via /auth/refresh)
# oauth — OAuth/PKCE flow against the providers in src/modules/auth
VUESTRATA_AUTH_ADAPTER=mock

# ── UI / theming ───────────────────────────────────────────
# solar | lucide | phosphor
VUESTRATA_ICON_PROVIDER=solar

# Default theme name for fresh sessions. Persisted `vuestrata-theme`
# localStorage values override this after the first visit.
# default | blueprint | brutalist | febin | forest | ghibli | ocean | rose | sunset | terminal
VUESTRATA_THEME=default

# ── Demo mode only ─────────────────────────────────────────
# How long (in hours, 1–720) demo sessions remain in IndexedDB.
# Ignored entirely in production mode.
VUESTRATA_DEMO_AUTH_RETENTION_HOURS=24

# ── Error reporting (optional) ─────────────────────────────
# Ingest DSN for an error-reporting provider. A DSN is a public write-only
# endpoint designed to be embedded in client bundles — it is NOT a secret.
# A provider API token is a secret and must never be put in a VUESTRATA_ var.
#
# Leave unset to disable reporting entirely (the correct state for the demo).
# The template ships no SDK; implement createReporter() in
# src/modules/app/plugins/error-reporting.ts to activate one.
# VUESTRATA_ERROR_REPORTING_DSN=https://examplePublicKey@o0.ingest.example.com/0

# Version string attached to error reports. CI sets this to the git SHA.
# VUESTRATA_RELEASE=
