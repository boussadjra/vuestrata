{
  "name": "@vuestrata/cli",
  "version": "1.0.1-alpha.6",
  "description": "Scaffold, inspect and upgrade a Vuestrata project.",
  "keywords": [
    "cli",
    "codemod",
    "generator",
    "migration",
    "scaffold",
    "starter-template",
    "template-upgrade",
    "vite-plus",
    "vue",
    "vue3",
    "vuestrata"
  ],
  "homepage": "https://github.com/boussadjra/vuestrata/blob/main/packages/cli/README.md",
  "bugs": {
    "url": "https://github.com/boussadjra/vuestrata/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boussadjra/vuestrata.git",
    "directory": "packages/cli"
  },
  "bin": {
    "vuestrata": "src/index.mjs"
  },
  "files": [
    "README.md",
    "src",
    "migrations",
    "payload"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./manifest": "./src/lib/manifest.mjs",
    "./plan": "./src/lib/plan.mjs",
    "./registry": "./src/lib/registry.mjs"
  },
  "scripts": {
    "prepack": "node scripts/build-payload.mjs"
  },
  "dependencies": {
    "consola": "^3.4.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
