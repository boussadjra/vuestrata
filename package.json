{
  "name": "vuestrata",
  "version": "1.0.1-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --port 3333 --host",
    "build": "vue-tsc --noEmit && vp build",
    "preview": "vp preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "vp lint && node scripts/lint/run-custom-rules.mjs && node scripts/msw/check-worker-version.mjs && node scripts/docs/check-links.mjs --quiet",
    "lint:docs": "node scripts/docs/check-links.mjs",
    "lint:fix": "vp lint --fix",
    "lint:inline-handlers": "node scripts/lint/run-custom-rules.mjs",
    "lint:msw-worker": "node scripts/msw/check-worker-version.mjs",
    "msw:sync": "vp exec msw init public --save",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "vp test",
    "test:all": "vp test --run",
    "test:unit": "vp test --run test/unit src/modules/**/__tests__",
    "test:component": "vp test --run test/component",
    "test:integration": "vp test --run test/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test e2e/smoke.spec.ts",
    "verify:bundle": "node scripts/build/verify-bundle.mjs",
    "test:coverage": "vp test --run --coverage",
    "deps:check": "taze major",
    "deps:update": "taze major -w && vp install",
    "version:show": "node scripts/release/version.mjs show",
    "version:set": "node scripts/release/version.mjs set",
    "version:patch": "node scripts/release/version.mjs patch",
    "version:minor": "node scripts/release/version.mjs minor",
    "version:major": "node scripts/release/version.mjs major",
    "version:prepatch": "node scripts/release/version.mjs prepatch --preid alpha",
    "version:preminor": "node scripts/release/version.mjs preminor --preid alpha",
    "version:premajor": "node scripts/release/version.mjs premajor --preid alpha",
    "version:prerelease": "node scripts/release/version.mjs prerelease --preid alpha",
    "version:prerelease:beta": "node scripts/release/version.mjs prerelease --preid beta",
    "version:prerelease:rc": "node scripts/release/version.mjs prerelease --preid rc",
    "release:verify": "vp check && vp test --run",
    "docker:build": "docker build -t vuestrata .",
    "docker:run": "docker run -p 8080:80 vuestrata",
    "prepare": "vp config"
  },
  "dependencies": {
    "@formwerk/core": "^0.14.4",
    "@shikijs/langs": "^4.0.2",
    "@shikijs/primitive": "^4.0.2",
    "@shikijs/themes": "^4.0.2",
    "@tanstack/vue-query": "^5.97.0",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/core": "^14.2.1",
    "axe-core": "^4.11.2",
    "beautiful-mermaid": "^1.1.3",
    "comark": "https://pkg.pr.new/comarkdown/comark/comark@05679bb",
    "consola": "^3.4.2",
    "echarts": "^6.0.0",
    "jwt-decode": "^4.0.0",
    "msw": "^2.13.2",
    "nprogress": "^0.2.0",
    "ofetch": "^1.5.1",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.5",
    "shiki": "^4.0.2",
    "vue": "^3.5.32",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.3.2",
    "vue-router": "^5.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@egoist/tailwindcss-icons": "^1.9.2",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/lucide": "^1.2.102",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.77",
    "@iconify-json/solar": "^1.2.5",
    "@intlify/unplugin-vue-i18n": "^11.0.7",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.9.1",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.4",
    "@vue/test-utils": "^2.4.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.2",
    "taze": "^19.11.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "catalog:",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
