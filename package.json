{
  "name": "vuestrata",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --port 3333 --host",
    "build": "vue-tsc --noEmit && vp build",
    "preview": "vp preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "vp lint && node scripts/lint/run-custom-rules.mjs",
    "lint:fix": "vp lint --fix",
    "lint:inline-handlers": "node scripts/lint/run-custom-rules.mjs",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "vp test",
    "test:all": "vp test --run",
    "test:unit": "vp test --run test/unit src/modules/**/__tests__",
    "test:component": "vp test --run test/component",
    "test:integration": "vp test --run test/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vp test --run --coverage",
    "deps:check": "taze major",
    "deps:update": "taze major -w && pnpm install",
    "docker:build": "docker build -t vuestrata .",
    "docker:run": "docker run -p 8080:80 vuestrata",
    "scaffold": "tsx scripts/scaffold.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "@formwerk/core": "^0.14.4",
    "@shikijs/langs": "^4.0.2",
    "@shikijs/primitive": "^4.0.2",
    "@shikijs/themes": "^4.0.2",
    "@tanstack/vue-query": "^5.97.0",
    "@tanstack/vue-table": "^8.21.3",
    "@vuetify/v0": "^0.2.1",
    "@vueuse/core": "^14.2.1",
    "arktype": "^2.2.0",
    "axe-core": "^4.11.2",
    "beautiful-mermaid": "^1.1.3",
    "comark": "https://pkg.pr.new/comarkdown/comark/comark@05679bb",
    "consola": "^3.4.2",
    "echarts": "^6.0.0",
    "jwt-decode": "^4.0.0",
    "msw": "^2.13.2",
    "nprogress": "^0.2.0",
    "ofetch": "^1.5.1",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.5",
    "shiki": "^4.0.2",
    "valibot": "^1.3.1",
    "vue": "^3.5.32",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.3.2",
    "vue-router": "^5.0.4",
    "yup": "^1.7.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@egoist/tailwindcss-icons": "^1.9.2",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/lucide": "^1.2.102",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.77",
    "@iconify-json/solar": "^1.2.5",
    "@intlify/unplugin-vue-i18n": "^11.0.7",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.2",
    "taze": "^19.11.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "catalog:",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
